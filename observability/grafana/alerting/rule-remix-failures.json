{
  "uid": "clipremix-remix-failures",
  "title": "ClipRemix: repeated remix failures",
  "folderUID": "clipremix",
  "ruleGroup": "clipremix-remix",
  "orgID": 1,
  "condition": "C",
  "data": [
    {
      "refId": "A",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "__DATASOURCE_UID__",
      "model": {
        "refId": "A",
        "expr": "sum by (deployment_environment, service_version) (increase(clipremix_remix_failures_total{service_name=\"clipremix\", deployment_environment=~\"dev|prod\"}[5m]))",
        "instant": true,
        "range": false,
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "B",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "__expr__",
      "model": {
        "refId": "B",
        "type": "reduce",
        "expression": "A",
        "reducer": "last",
        "settings": { "mode": "dropNN" },
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    },
    {
      "refId": "C",
      "relativeTimeRange": { "from": 600, "to": 0 },
      "datasourceUid": "__expr__",
      "model": {
        "refId": "C",
        "type": "threshold",
        "expression": "B",
        "conditions": [{ "evaluator": { "type": "gt", "params": [4.5] } }],
        "intervalMs": 1000,
        "maxDataPoints": 43200
      }
    }
  ],
  "noDataState": "OK",
  "execErrState": "OK",
  "for": "5m",
  "isPaused": false,
  "labels": {
    "service": "clipremix",
    "environment": "{{ $labels.deployment_environment }}",
    "version": "{{ $labels.service_version }}",
    "owner": "qwopop"
  },
  "annotations": {
    "summary": "ClipRemix {{ $labels.deployment_environment }} ({{ $labels.service_version }}): repeated remix failures",
    "description": "Saving remixes fails with an unexpected server error (HTTP 500): about 5 or more failures in the last 5 minutes, sustained for 5 minutes. Users of the {{ $labels.deployment_environment }} environment, version {{ $labels.service_version }}, cannot create, update or template remixes.",
    "dashboard_url": "__GRAFANA_URL__/d/clipremix-app/clipremix-application?var-environment={{ $labels.deployment_environment }}&var-version={{ $labels.service_version }}",
    "runbook_url": "https://github.com/qwopop/competitor-reels-tool/blob/main/docs/runbook.md"
  }
}
